#!/bin/sh
# Run each bounded operation in its own process group; clean descendants too.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/opt/mu300/busybox-bin
keep=0
[ "${1:-}" != --keep-background ] || { keep=1; shift; }
limit=$1; shift
case "$limit" in ''|*[!0-9]*) exit 2;; esac
[ "$limit" -gt 0 ] || exit 2
worker=''; timer=''; code=1
state=$(mktemp -d /tmp/f50-bounded.XXXXXX) || exit 1
cleanup() {
 [ -z "$timer" ] || /opt/mu300/bin/busybox kill -KILL "-$timer" 2>/dev/null
 # A successful service launch may still be configuring its firewall.
 [ "$keep" = 1 ] && [ "$code" = 0 ] && [ ! -f "$state/timed-out" ] && { rm -rf "$state"; return 0; }
 # Give nested bounded helpers time to clean their own detached groups.
 trap '' TERM INT
 if [ -n "$worker" ] && /opt/mu300/bin/busybox kill -0 "-$worker" 2>/dev/null; then
  # Snapshot descendants before TERM: nested setsid helpers own separate groups.
  descendants=$(awk -v root="$worker" '
   BEGIN { for(i=1;i<ARGC;i++) { file=ARGV[i]; if((getline line < file)>0) {
    split(file,f,"/"); id=f[3]; sub(/^.*\) /,"",line); split(line,a," "); parent[id]=a[2]; tick[id]=a[20]
   } close(file) }
   for(id in parent) { p=id; n=0; while(p>1 && n++<64) {
    if(p==root) { print id, tick[id]; break } p=parent[p]
   } } exit }' /proc/[0-9]*/stat 2>/dev/null)
  /opt/mu300/bin/busybox kill -TERM "-$worker" 2>/dev/null
  sleep 3
  /opt/mu300/bin/busybox kill -KILL "-$worker" 2>/dev/null
 fi
 # The timeout monitor snapshots before killing the parent: detached children
 # are otherwise reparented and no longer discoverable by the caller.
 { printf '%s\n' "${descendants:-}"; cat "$state/descendants" 2>/dev/null; } | while read -r child tick; do
   [ -n "$child" ] && [ -r "/proc/$child/stat" ] || continue
   current=$(sed 's/.*) //' "/proc/$child/stat" 2>/dev/null | awk '{print $20}')
   [ "$current" = "$tick" ] || continue
   /opt/mu300/bin/busybox kill -KILL "$child" 2>/dev/null
 done
 rm -rf "$state"
}
trap cleanup EXIT
trap 'exit 143' TERM INT
# Preserve caller input: ash otherwise gives asynchronous jobs /dev/null.
exec 3<&0
/usr/bin/setsid "$@" <&3 3<&- &
exec 3<&-
worker=$!
/usr/bin/setsid sh -c '
 sleep "$1"
 awk -v root="$2" '\''
 BEGIN { for(i=1;i<ARGC;i++) { file=ARGV[i]; if((getline line < file)>0) {
  split(file,f,"/"); id=f[3]; sub(/^.*\) /,"",line); split(line,a," "); parent[id]=a[2]; tick[id]=a[20]
 } close(file) }
 for(id in parent) { p=id; n=0; while(p>1 && n++<64) {
  if(p==root) { print id, tick[id]; break } p=parent[p]
 } } exit }'\'' /proc/[0-9]*/stat > "$3/descendants.new" 2>/dev/null
 mv "$3/descendants.new" "$3/descendants"
 : > "$3/timed-out"
 /opt/mu300/bin/busybox kill -TERM "-$2" 2>/dev/null
 sleep 5
 /opt/mu300/bin/busybox kill -KILL "-$2" 2>/dev/null
' sh "$limit" "$worker" "$state" &
timer=$!
wait "$worker"
code=$?
[ ! -f "$state/timed-out" ] || code=124
exit "$code"
