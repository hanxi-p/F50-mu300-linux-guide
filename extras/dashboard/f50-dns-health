#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/opt/mu300/busybox-bin
case "$1" in 53|5353|7874) ;; *) exit 2;; esac
answer=$(/usr/libexec/f50-bounded 4 nslookup -port="$1" -timeout=2 -retry=1 -type=A example.com 127.0.0.1 2>&1)
code=$?
# A policy block returning NXDOMAIN is a valid DNS response, not a service outage.
[ "$code" = 0 ] || printf '%s\n' "$answer" | grep -qi NXDOMAIN
