#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/opt/mu300/busybox-bin
LOCK=/tmp/f50openclash.lock
trap '/usr/libexec/f50-lock release "$LOCK" $$; /usr/libexec/f50-lock release /tmp/f50dns-switch.lock $$' EXIT
/usr/libexec/f50-lock adopt "$LOCK" $$ || exit 1
/usr/libexec/f50-lock adopt /tmp/f50dns-switch.lock $$ || exit 1
trap 'exit 1' INT TERM
old=$(uci -q get openclash.config.enable || echo 0)
fail() { printf '%s' "$1" > /tmp/f50openclash-error; exit 1; }
dns() { /usr/libexec/f50-dns-route "$1"; }
case "$1" in
1)
    uci set openclash.config.enable=1; uci commit openclash
    /etc/init.d/openclash enable
    /usr/libexec/f50-bounded --keep-background 60 /etc/init.d/openclash start || fail 'OpenClash 启动命令失败'
    n=0
    while [ "$n" -lt 75 ]; do
        if pidof clash >/dev/null && nft list chain inet fw4 openclash >/dev/null 2>&1 && nft list chain inet fw4 openclash_output >/dev/null 2>&1; then break; fi
        sleep 1; n=$((n+1))
    done
    if [ "$n" -ge 75 ]; then
        dns 0
        uci set openclash.config.enable=0; uci commit openclash
        /usr/libexec/f50-bounded --keep-background 45 /etc/init.d/openclash stop
        fail 'OpenClash 核心或防火墙未就绪，已恢复直连 DNS'
    fi
    if ! pidof clash >/dev/null; then uci set openclash.config.enable="$old"; uci commit openclash; fail 'OpenClash 启动失败，请查看插件日志'; fi
    dns 1 || fail 'OpenClash 已启动，但 DNS 接回失败，请检查 dnsmasq 与核心 DNS'
    ;;
0)
    dns 0 || fail '直连 DNS 设置失败，已保留 OpenClash 运行状态'
    uci set openclash.config.enable=0; uci commit openclash
    /usr/libexec/f50-bounded --keep-background 45 /etc/init.d/openclash stop
    if pidof clash >/dev/null; then
        uci set openclash.config.enable="$old"; uci commit openclash
        dns 1
        fail 'OpenClash 未能停止，请查看插件日志'
    fi
    dns 0 || fail "直连 DNS 恢复失败"
    ;;
esac
