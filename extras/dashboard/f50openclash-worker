#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
LOCK=/tmp/f50openclash.lock
echo $$ > "$LOCK/pid"
trap 'rm -f "$LOCK/pid" "$LOCK/target"; rmdir "$LOCK" 2>/dev/null' EXIT
trap 'exit 1' INT TERM
old=$(uci -q get openclash.config.enable || echo 0)
fail() { printf '%s' "$1" > /tmp/f50openclash-error; exit 1; }
dns() {
    [ -x /etc/init.d/adguardhome ] && /etc/init.d/adguardhome running >/dev/null 2>&1 || return 0
    api=$(uci -q get f50dashboard.main.adguard_url || echo 'http://192.168.50.1:3000')
    [ -r /etc/f50openclash-adguard.netrc ] || return 1
    if [ "$1" = 1 ]; then
        config='{"upstream_dns":["127.0.0.1:7874"],"fallback_dns":["223.5.5.5","119.29.29.29"]}'
    else
        config='{"upstream_dns":["223.5.5.5","119.29.29.29"],"fallback_dns":[]}'
    fi
    curl -fsS --max-time 12 --netrc-file /etc/f50openclash-adguard.netrc -H 'Content-Type: application/json' --data "$config" "${api%/}/control/dns_config" >/dev/null || return 1
    curl -fsS --max-time 12 --netrc-file /etc/f50openclash-adguard.netrc -X POST "${api%/}/control/cache_clear" >/dev/null
}
case "$1" in
1)
    uci set openclash.config.enable=1; uci commit openclash
    /etc/init.d/openclash enable
    /etc/init.d/openclash start
    n=0
    while ! pidof clash >/dev/null && [ "$n" -lt 60 ]; do sleep 1; n=$((n+1)); done
    if ! pidof clash >/dev/null; then uci set openclash.config.enable="$old"; uci commit openclash; fail 'OpenClash 启动失败，请查看插件日志'; fi
    dns 1 || fail 'OpenClash 已启动，但 DNS 接回失败，请检查 AdGuard Home'
    ;;
0)
    dns 0 || fail '直连 DNS 设置失败，已保留 OpenClash 运行状态'
    uci set openclash.config.enable=0; uci commit openclash
    /etc/init.d/openclash stop
    if pidof clash >/dev/null; then
        uci set openclash.config.enable="$old"; uci commit openclash
        dns 1
        fail 'OpenClash 未能停止，请查看插件日志'
    fi
    # Keep the filtering service in the DNS path after OpenClash removes its rules.
    if [ -x /etc/init.d/adguardhome ] && /etc/init.d/adguardhome running >/dev/null 2>&1; then
        uci -q delete dhcp.@dnsmasq[0].server
        uci add_list dhcp.@dnsmasq[0].server='127.0.0.1#5353'
        uci set dhcp.@dnsmasq[0].noresolv=1
        uci commit dhcp; /etc/init.d/dnsmasq reload
    fi
    ;;
esac
