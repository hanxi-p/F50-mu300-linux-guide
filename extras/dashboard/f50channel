#!/bin/sh
. /usr/share/libubox/jshn.sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
fail(){ json_init; json_add_boolean ok 0; json_add_string error "$1"; json_dump; }
frequencies(){ ubus call iwinfo freqlist '{"device":"wlan0"}' 2>/dev/null; }
case "$1" in
list) echo '{"status":{},"set":{"channel":"String"}}';;
call)
 case "$2" in
 status)
  f=$(frequencies)
  json_init; json_add_boolean ok 1; json_add_string channel "$(uci -q get wireless.radio0.channel)"; json_add_string band "$(uci -q get wireless.radio0.band)"; json_add_string htmode "$(uci -q get wireless.radio0.htmode)"; json_add_string frequencies "$f"; json_dump;;
 set)
  json_load "$(cat)" || { fail '请求格式错误'; exit; }; json_get_var target channel
  if [ "$target" != auto ]; then
   printf '%s' "$target" | grep -Eq '^[0-9]{1,3}$' || { fail '无效信道'; exit; }
   band=$(uci -q get wireless.radio0.band); mode=$(uci -q get wireless.radio0.htmode)
   case "$band" in 5g) wanted_band=5;; 2g) wanted_band=2;; *) fail '不支持的无线频段'; exit;; esac
   json_load "$(frequencies)" || { fail '无法读取支持的信道'; exit; }; json_select results; json_get_keys keys; found=0
   for k in $keys; do
    json_select "$k"; json_get_var c channel; json_get_var b band; json_get_var restricted restricted
    if [ "$c" = "$target" ] && [ "$restricted" = 0 ] && [ "$b" = "$wanted_band" ]; then found=1; fi
    json_select ..
   done
   [ "$found" = 1 ] || { fail '此信道不适用于当前频段'; exit; }
   if [ "$band" = 5g ] && [ "$mode" = VHT80 ]; then
    case "$target" in 36|40|44|48|52|56|60|64|149|153|157|161) :;; *) fail '此信道不支持当前 80 MHz 带宽'; exit;; esac
   fi
  fi
  old=$(uci -q get wireless.radio0.channel)
  [ "$old" = "$target" ] && { json_init; json_add_boolean ok 1; json_add_boolean changed 0; json_dump; exit; }
  uci set wireless.radio0.channel="$target" && uci commit wireless || { uci revert wireless; fail '保存失败'; exit; }
  setsid /bin/sh -c 'sleep 1; wifi reload' </dev/null >/tmp/f50-channel-reload.log 2>&1 &
  json_init; json_add_boolean ok 1; json_add_boolean changed 1; json_dump;;
 esac;;
esac
