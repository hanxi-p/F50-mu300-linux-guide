#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/opt/mu300/busybox-bin
LOCK=/tmp/f50highrail.lock
STATE=/tmp/f50highrail.json
ERROR=/tmp/f50highrail-error
/usr/libexec/f50-lock adopt "$LOCK" $$ || exit 1
trap '/usr/libexec/f50-lock release "$LOCK" $$' EXIT
trap 'exit 1' INT TERM
query() {
 response=$(/usr/bin/setsid timeout -k 1 6 /usr/libexec/unisoc-modem/at -t 4 'AT+SP5GCMDS="get nr synch_param",44' 2>/dev/null)
 value=$(printf '%s\n' "$response" | tr -d '\r' | sed -n 's/^+SP5GCMDS: *get nr synch_param,44,\([01]\).*$/\1/p' | head -1)
 case "$value" in 0|1) return 0;; *) return 1;; esac
}
save() { printf '{"enabled":%s,"supported":true,"ts":%s}\n' "$value" "$(date +%s)" > "$STATE.new"; mv "$STATE.new" "$STATE"; }
if ! query && ! query; then
 echo '基带高铁参数查询失败，未执行设置' > "$ERROR"
 # A temporary AT timeout does not prove this modem lacks the feature.
 [ -s "$STATE" ] || printf '{"enabled":false,"supported":false,"ts":0}\n' > "$STATE"
 exit 1
fi
save
if [ "$1" = refresh ]; then rm -f "$ERROR"; exit 0; fi
case "$1" in 0|1) target=$1;; *) exit 2;; esac
if [ -d /run/unisoc-modem-lock-apply ]; then echo '制式或频段正在切换，请稍后操作' > "$ERROR"; exit 1; fi
if [ "$value" != "$target" ]; then
 /usr/bin/setsid timeout -k 1 6 /usr/libexec/unisoc-modem/at -t 4 "AT+SP5GCMDS=\"set nr param\",35,$target" >/dev/null 2>&1
 if ! query; then echo '设置后读回失败，请重新检查基带状态' > "$ERROR"; exit 1; fi
 save
 [ "$value" = "$target" ] || { echo '基带读回值与设置不一致' > "$ERROR"; exit 1; }
fi
rm -f "$ERROR"
logger -t f50-highrail "native high rail parameter readback=$value; no periodic forced cell locking"
