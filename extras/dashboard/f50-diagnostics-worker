#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/opt/mu300/busybox-bin
umask 077
root=${2:-/opt/f50-diagnostics}; queue=${3:-/tmp/f50-diag-queue}
case "$root" in /opt/f50-diagnostics|/tmp/f50-diag-test-*) ;; *) exit 2;; esac
limit=2097152
case "$root" in /tmp/f50-diag-test-*) limit=${F50_DIAG_TEST_MAX_KB:-2097152};; esac
case "$limit" in ''|*[!0-9]*) exit 2;; esac
case "$queue" in /tmp/f50-diag-*) ;; *) exit 2;; esac
mkdir -p "$root" "$queue" || exit 1
[ ! -L "$root" ] && [ ! -L "$queue" ] || exit 1
chmod 700 "$root" "$queue"
exec 9>"$queue/collector.lock"
flock -n 9 || exit 0
reader=''; filter=''; sleeper=''; active=''
stop_reader() {
 [ -z "$reader" ] || kill "$reader" 2>/dev/null
 [ -z "$filter" ] || kill "$filter" 2>/dev/null
 [ -z "$reader" ] || wait "$reader" 2>/dev/null
 [ -z "$filter" ] || wait "$filter" 2>/dev/null
 reader=''; filter=''
}
cleanup() { stop_reader; [ -z "$sleeper" ] || { kill "$sleeper" 2>/dev/null; wait "$sleeper" 2>/dev/null; }; }
trap cleanup EXIT
trap 'exit 143' TERM INT
rotate() {
 [ ! -f "$1" ] || [ "$(wc -c < "$1")" -lt 4194304 ] || mv "$1" "$1.previous.log"
}
snapshot() {
 rotate "$day/state.log"
 {
  date '+%Y-%m-%dT%H:%M:%S%z'; cat /proc/loadavg; free; ps w
  for f in /tmp/f50openclash-error /tmp/f50adguard-error /tmp/f50power-error /var/run/unisoc-modem/lock-apply.error /var/run/unisoc-modem/cell.json; do
   if [ -r "$f" ]; then printf '\n--- %s ---\n' "$f"; head -c 8192 "$f"; fi
  done
  printf '\n'
 } >> "$day/state.log"
}
prune() {
 now=$(date +%s)
 # Do not expire history until the clock is plausible (2025 or later).
 cutoff=''
 [ "$now" -lt 1735689600 ] || cutoff=$(date -d "@$((now-29*86400))" +%Y-%m-%d)
 for d in "$root"/????-??-??; do
  [ -d "$d" ] && [ ! -L "$d" ] || continue
  name=${d##*/}
  if [ -n "$cutoff" ] && [ "$name" \< "$cutoff" ]; then rm -f "$d"/*.log; rmdir "$d" 2>/dev/null; fi
 done
 # Oldest days first. Never remove today's data or anything outside this directory.
 for d in "$root"/????-??-??; do
  [ -d "$d" ] && [ ! -L "$d" ] && [ "$d" != "$day" ] || continue
  size=$(du -sk "$root" | awk '{print $1}')
  [ "$size" -gt "$limit" ] || break
  rm -f "$d"/*.log; rmdir "$d" 2>/dev/null
 done
}
collect() {
 day="$root/$(date +%Y-%m-%d)"
 mkdir -p "$day" || return 1
 [ ! -L "$day" ] || return 1
 if [ "$active" != "$day" ] || { [ -f "$day/system.log" ] && [ "$(wc -c < "$day/system.log")" -ge 4194304 ]; }; then
  stop_reader; rotate "$day/system.log"
  if [ "$1" != once ]; then
   # Exclude routine driver chatter; retain control and meaningful failure messages.
   # logread -e uses basic regex on this image; use awk for explicit alternatives.
   rm -f "$queue/system.fifo"
   mkfifo "$queue/system.fifo" || return 1
   logread -f > "$queue/system.fifo" & reader=$!
   # Preserve a bounded kernel crash context, including register/stack lines.
   awk '
    /coredump|Comm: rpcd|segfault|kernel panic|BUG:|hung task|Call trace:/ { context=96 }
    { keep=($0 ~ /f50-|daemon\.(err|crit|alert|emerg)|Out of memory|oom-kill|segfault|kernel panic|BUG:|hung task|coredump|Comm: rpcd|hostapd.*(fail|error)|rpcd.*(fail|error)|unisoc-modem.*(fail|error|timeout)/);
      if (context>0 && $0 ~ /kernel:/) { keep=1; context-- }
      if (keep) { print; fflush(); }
    }' < "$queue/system.fifo" >> "$day/system.log" & filter=$!
  fi
  active=$day
 fi
 failed=0
 if [ -f "$queue/overflow" ]; then
  rotate "$day/errors.log"
  printf '%s diagnostic queue overflow: some records dropped\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" >> "$day/errors.log" && { rm -f "$queue/overflow"; failed=1; }
 fi
 for f in "$queue"/*.pending; do
  [ -f "$f" ] && [ ! -L "$f" ] || continue
  rotate "$day/events.log"
  if cat "$f" >> "$day/events.log"; then
   grep -q 'code=0 ' "$f" || failed=1
   rm -f "$f"
  fi
 done
 # Capture persistent error notices not routed through the switch worker.
 for f in /tmp/f50openclash-error /tmp/f50adguard-error /tmp/f50power-error /var/run/unisoc-modem/lock-apply.error; do
  [ -s "$f" ] || continue
  hash=$(sha256sum "$f" | cut -d' ' -f1); key="$queue/${f##*/}.hash"
  [ "$hash" != "$(cat "$key" 2>/dev/null)" ] || continue
  rotate "$day/errors.log"
  { date '+%Y-%m-%dT%H:%M:%S%z'; printf '%s\n' "$f"; head -c 4096 "$f"; printf '\n'; } >> "$day/errors.log" && { echo "$hash" > "$key"; failed=1; }
 done
 [ "$failed" = 0 ] || snapshot
 prune
}
if [ "$1" = once ]; then collect once; exit $?; fi
snapshot_pending=1
while :; do
 collect loop
 if [ "$snapshot_pending" = 1 ]; then snapshot; snapshot_pending=0; fi
 # Restart a failed log reader without disturbing any network service.
 if { [ -n "$reader" ] && ! kill -0 "$reader" 2>/dev/null; } || { [ -n "$filter" ] && ! kill -0 "$filter" 2>/dev/null; }; then stop_reader; active=''; fi
 sleep 15 & sleeper=$!; wait "$sleeper"; sleeper=''
done
