#!/bin/sh
# Enqueue in RAM only. The independent collector performs SD writes.
umask 077
queue=${F50_DIAG_QUEUE:-/tmp/f50-diag-queue}
case "$queue" in /tmp/f50-diag-*) ;; *) exit 2;; esac
case "$1" in openclash|adguard|power|incident) kind=$1;; *) exit 2;; esac
mkdir -p "$queue" || exit 1
[ ! -L "$queue" ] || exit 1
[ "$(ls "$queue" 2>/dev/null | wc -l)" -lt 128 ] || { touch "$queue/overflow"; exit 1; }
file=$(mktemp "$queue/event.XXXXXX") || exit 1
{
 printf '%s kind=%s target=%s code=%s elapsed=%ss\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$kind" "$2" "$3" "$4"
 if [ "${3:-0}" != 0 ]; then
  [ ! -r "/tmp/f50${kind}-error" ] || head -c 2048 "/tmp/f50${kind}-error"
  printf '\n--- control output ---\n'
  [ ! -r "/tmp/f50${kind}-control.log" ] || tail -c 4096 "/tmp/f50${kind}-control.log"
 fi
} > "$file"
mv "$file" "$file.pending"
