#!/bin/sh
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/opt/mu300/busybox-bin
LOCK=/tmp/f50adguard.lock
trap '/usr/libexec/f50-lock release "$LOCK" $$; /usr/libexec/f50-lock release /tmp/f50dns-switch.lock $$' EXIT
/usr/libexec/f50-lock adopt "$LOCK" $$ || exit 1
/usr/libexec/f50-lock adopt /tmp/f50dns-switch.lock $$ || exit 1
trap 'exit 1' INT TERM
case "$1" in
1) /etc/init.d/adguardhome enable; /usr/libexec/f50-bounded 45 /etc/init.d/adguardhome start
 n=0; until pidof AdGuardHome >/dev/null; do n=$((n+1)); [ "$n" -lt 15 ] || { echo 'AdGuard Home 启动失败' > /tmp/f50adguard-error; exit 1; }; sleep 1; done
 sleep 2;;
0) /usr/libexec/f50-dns-route auto off; /etc/init.d/adguardhome disable; /usr/libexec/f50-bounded 45 /etc/init.d/adguardhome stop;;
esac
if [ "$1" = 0 ]; then /usr/libexec/f50-dns-route auto off; else /usr/libexec/f50-dns-route auto; fi || { echo 'DNS 联动失败，请检查服务' > /tmp/f50adguard-error; exit 1; }
