#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/opt/mu300/busybox-bin
LOCK=/tmp/f50wifi-start.lock
/usr/libexec/f50-lock acquire "$LOCK" $$ || exit 0
trap '/usr/libexec/f50-lock release "$LOCK" $$' EXIT
trap 'exit 1' INT TERM
country=$(uci -q get wireless.radio0.country)
case "$country" in [A-Z][A-Z]) ;; *) logger -t f50-wifi-start 'No valid country configured; leaving Wi-Fi unchanged'; exit 1;; esac
enabled() {
 [ "$(uci -q get wireless.radio0.disabled)" != 1 ] && [ "$(uci -q get wireless.ap0.disabled)" != 1 ]
}
enabled || exit 0
ready=0
for n in $(seq 1 12); do
 /usr/libexec/f50-bounded 5 iw reg set "$country" >/dev/null 2>&1
 if /usr/libexec/f50-bounded 5 iw reg get | grep -q "country $country:"; then ready=1; break; fi
 sleep 1
done
if [ "$ready" != 1 ]; then
 logger -t f50-wifi-start 'Country not ready; Wi-Fi recovery deferred to guard'
 exit 1
fi
if [ "$(uci -q get wireless.radio0.band)" = 5g ]; then
 /usr/libexec/f50-wifi-nondfs apply >/dev/null || {
  logger -t f50-wifi-start 'No legal non-DFS channel block available; recovery deferred'
  exit 1
 }
fi
for attempt in 1 2; do
 enabled || exit 0
 logger -t f50-wifi-start "Country $country ready; AP start attempt $attempt"
 /usr/libexec/f50-bounded 30 wifi down
 sleep 3
 enabled || exit 0
 /usr/libexec/f50-bounded 60 wifi up
 # ACS/HT scan can take over a minute on this driver.
 for n in $(seq 1 25); do
  enabled || exit 0
  if /usr/libexec/f50-bounded 5 ubus call hostapd.wlan0 get_status 2>/dev/null | grep -q '"status": "ENABLED"'; then
   logger -t f50-wifi-start 'AP verified ENABLED'
   exit 0
  fi
  sleep 2
 done
done
logger -t f50-wifi-start 'AP start did not complete; leaving USB available for recovery'
exit 1
