#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/opt/mu300/busybox-bin
LOCK=/tmp/f50wifi-start.lock
/usr/libexec/f50-lock acquire "$LOCK" $$ || exit 0
trap '/usr/libexec/f50-lock release "$LOCK" $$' EXIT
trap 'exit 1' INT TERM
country=$(uci -q get wireless.radio0.country)
case "$country" in [A-Z][A-Z]) ;; *) logger -t f50-wifi-start 'No valid country configured; leaving Wi-Fi unchanged'; exit 1;; esac
enabled() {
 [ "$(uci -q get wireless.radio0.disabled)" != 1 ] && [ "$(uci -q get wireless.ap0.disabled)" != 1 ]
}
enabled || exit 0
# Some vendor boots expose an all-zero PHY address although wlan0 has its
# assigned address. Pin only a missing/invalid AP address to that real address.
valid_mac() {
 printf '%s\n' "$1" | grep -Eq '^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$' || return 1
 case "$1" in 00:00:00:00:00:00|ff:ff:ff:ff:ff:ff|FF:FF:FF:FF:FF:FF) return 1;; esac
 first=${1%%:*}
 [ $((0x$first & 1)) -eq 0 ]
}
# Boot verification must not tear down an AP that netifd already brought up.
# Explicit recovery/install calls without this flag retain their old behavior.
if [ "${1:-}" = --if-needed ]; then
 ap=$(/usr/libexec/f50-bounded 5 ubus call hostapd.wlan0 get_status 2>/dev/null)
 ap_state=$(printf '%s\n' "$ap" | jsonfilter -e '@.status')
 ap_mac=$(printf '%s\n' "$ap" | jsonfilter -e '@.bssid')
 pending=$(/usr/libexec/f50-bounded 5 ubus call network.wireless status 2>/dev/null | jsonfilter -e '@.radio0.pending')
 if [ "$ap_state" = ENABLED ] && valid_mac "$ap_mac" && [ "$pending" = false ] &&
    /usr/libexec/f50-bounded 5 ip link show wlan0 2>/dev/null | grep -q LOWER_UP; then
  logger -t f50-wifi-start 'AP already healthy; boot verification skipped restart'
  exit 0
 fi
fi
configured_mac=$(uci -q get wireless.ap0.macaddr)
if ! valid_mac "$configured_mac"; then
 actual_mac=$(cat /sys/class/net/wlan0/address 2>/dev/null)
 if ! valid_mac "$actual_mac"; then
  logger -t f50-wifi-start 'No valid interface MAC; recovery deferred without starting a zero-BSSID AP'
  exit 1
 fi
 uci set wireless.ap0.macaddr="$actual_mac" && uci commit wireless || exit 1
fi
ready=0
for n in $(seq 1 12); do
 /usr/libexec/f50-bounded 5 iw reg set "$country" >/dev/null 2>&1
 if /usr/libexec/f50-bounded 5 iw reg get | grep -q "country $country:"; then ready=1; break; fi
 sleep 1
done
if [ "$ready" != 1 ]; then
 logger -t f50-wifi-start 'Country not ready; Wi-Fi recovery deferred to guard'
 exit 1
fi
if [ "$(uci -q get wireless.radio0.band)" = 5g ]; then
 /usr/libexec/f50-wifi-nondfs apply >/dev/null || {
  logger -t f50-wifi-start 'No legal non-DFS channel block available; recovery deferred'
  exit 1
 }
fi
for attempt in 1 2; do
 enabled || exit 0
 logger -t f50-wifi-start "Country $country ready; AP start attempt $attempt"
 /usr/libexec/f50-bounded 30 wifi down
 sleep 3
 enabled || exit 0
 /usr/libexec/f50-bounded 60 wifi up
 # ACS/HT scan can take over a minute on this driver.
 for n in $(seq 1 25); do
  enabled || exit 0
  status=$(/usr/libexec/f50-bounded 5 ubus call hostapd.wlan0 get_status 2>/dev/null)
  bssid=$(printf '%s\n' "$status" | jsonfilter -e '@.bssid')
  if printf '%s\n' "$status" | grep -q '"status": "ENABLED"' && valid_mac "$bssid"; then
   logger -t f50-wifi-start 'AP ENABLED with valid BSSID; client connectivity requires separate verification'
   exit 0
  fi
  sleep 2
 done
done
logger -t f50-wifi-start 'AP start did not complete; leaving USB available for recovery'
exit 1
