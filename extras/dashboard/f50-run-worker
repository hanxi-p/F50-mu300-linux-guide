#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/opt/mu300/busybox-bin
kind=$1; target=$2
case "$kind" in adguard|openclash|power) ;; *) exit 2;; esac
worker=/usr/libexec/f50${kind}-worker
started=$(date +%s)
event=/tmp/f50${kind}-events.log
umask 077
if [ "${3:-}" != claimed ]; then
 if [ "$kind" != power ]; then /usr/libexec/f50-lock acquire /tmp/f50dns-switch.lock $$ || exit 1; fi
 if ! /usr/libexec/f50-lock acquire "/tmp/f50${kind}.lock" $$; then
  [ "$kind" = power ] || /usr/libexec/f50-lock release /tmp/f50dns-switch.lock $$
  exit 1
 fi
fi
case "$kind" in
 openclash|adguard) /usr/libexec/f50-bounded --keep-background 180 "$worker" "$target";;
 *) /usr/libexec/f50-bounded 150 "$worker" "$target";;
esac
code=$?
finished=$(date +%s)
elapsed=$((finished-started))
case "$kind" in openclash) label=OpenClash;; adguard) label='AdGuard Home';; power) label='CPU 模式';; esac
if [ "$code" != 0 ]; then
 if [ ! -s "/tmp/f50${kind}-error" ]; then
  if [ "$code" = 124 ]; then reason='切换超时'; else reason='切换失败'; fi
  printf '%s：%s（返回码 %s，%s 秒）；请查看切换记录。\n' "$label" "$reason" "$code" "$elapsed" > "/tmp/f50${kind}-error"
 fi
 logger -t f50-control "$kind worker returned $code"
fi
# Keep recent operation evidence outside the noisy kernel log. No extra service locks.
if [ -f "$event" ] && [ "$(wc -l < "$event")" -ge 100 ]; then
 tail -n 50 "$event" > "$event.$$" && mv "$event.$$" "$event"
fi
printf '%s kind=%s target=%s code=%s elapsed=%ss\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$kind" "$target" "$code" "$elapsed" >> "$event"
/usr/libexec/f50-lock sweep "/tmp/f50${kind}.lock"
/usr/libexec/f50-lock sweep /tmp/f50dns-switch.lock
if [ -x /usr/libexec/f50-diagnostics ]; then
 /usr/libexec/f50-bounded 2 /usr/libexec/f50-diagnostics "$kind" "$target" "$code" "$elapsed" || true
fi
exit "$code"
