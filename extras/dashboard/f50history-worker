#!/bin/sh
set -eu
D=/tmp/f50-dashboard-live
mkdir -p "$D"; chmod 700 "$D"
n=0
while :; do
 ts=$(date +%s)
 rx=$(cat /sys/class/net/sipa_eth0/statistics/rx_bytes 2>/dev/null || echo 0)
 tx=$(cat /sys/class/net/sipa_eth0/statistics/tx_bytes 2>/dev/null || echo 0)
 printf '%s %s %s\n' "$ts" "$rx" "$tx" >> "$D/samples"
 awk -v now="$ts" '$1>=now-300' "$D/samples" | tail -n 200 > "$D/samples.new"
 mv "$D/samples.new" "$D/samples"
 awk 'BEGIN{printf "["} NR>1 {dt=$1-t; if(dt>0){a=($2>=rx?($2-rx)/dt:0);b=($3>=tx?($3-tx)/dt:0);printf "%s[%s,%.3f,%.3f]",sep,$1,a,b;sep=","}} {t=$1;rx=$2;tx=$3} END{print "]"}' "$D/samples" > "$D/history.new"
 mv "$D/history.new" "$D/history.json"
 if [ "$n" -eq 0 ]; then
  if /opt/mu300/busybox-bin/timeout -k 3 20 ubus call mu300dash status > "$D/status.new" && jsonfilter -i "$D/status.new" -e '@.info.ts' >/dev/null 2>&1; then
   [ ! -f "$D/status.json" ] || cp "$D/status.json" "$D/previous.json"
   mv "$D/status.new" "$D/status.json"
  fi
 fi
 n=$(((n+1)%3))
 sleep 2
done
